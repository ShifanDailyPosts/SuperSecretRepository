# ----------------------------------------------------------------------
# Keamanan & Proteksi Berkas Portofolio Shifan
# ----------------------------------------------------------------------

# 1. Nonaktifkan Directory Listing (Mencegah pengunjung melihat isi folder)
Options -Indexes

# 2. Blokir akses langsung ke berkas sensitif & tersembunyi
<FilesMatch "^\.|\.(env|ps1|sh|json|log|md|yml|yaml|git|bak|backup|sql|cfg|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Security HTTP Headers
<IfModule mod_headers.c>
    # Cegah Clickjacking (website di-embed di iframe luar)
    Header always set X-Frame-Options "SAMEORIGIN"
    # Cegah MIME Type Sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Proteksi XSS pada browser lama
    Header always set X-XSS-Protection "1; mode=block"
    # Kontrol Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
